{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "securetag-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3100,
      "autoPort": false
    },
    {
      "name": "securetag-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3100,
      "autoPort": false
    },
    {
      "name": "securetag-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3210"
      ],
      "port": 3210,
      "autoPort": true
    },
    {
      "name": "securetag-legacy",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd /d D:\\securetag-legacy && npm run dev"
      ],
      "port": 3200
    },
    {
      "name": "securetag-mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mobile",
        "run",
        "web",
        "--",
        "--port",
        "8090"
      ],
      "port": 8090,
      "autoPort": false
    },
    {
      "name": "securetag-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:mobile"
      ],
      "port": 4100,
      "autoPort": false
    }
  ]
}
