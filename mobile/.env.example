# Public values only. Never put the service-role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Website the app talks to. Leave blank while developing: the app then uses the
# Next.js dev server on this computer (port 4100: run `npm run dev:mobile` in the website folder). Set it once the website with
# /api/mobile is deployed: https://www.securetag.in (with www: the bare domain redirects and drops the login)
EXPO_PUBLIC_API_URL=

# Public site that QR codes point to.
EXPO_PUBLIC_WEB_URL=https://securetag.in
